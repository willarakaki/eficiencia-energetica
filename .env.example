# ==============================================================================
# Configurações de Ambiente (.env) - Eficiência Energética ESG
# ==============================================================================

# Porta da aplicação
APP_PORT=8080

# Configurações de Banco de Dados Local (Oracle Database 23ai Free)
DB_PORT=1521
DB_USER=fiap_user
DB_PASSWORD=oracle123
DB_URL=jdbc:oracle:thin:@oracle-db:1521/FREEPDB1

# Configuração de Segurança (Chave secreta para assinatura dos tokens JWT)
JWT_SECRET=chave-secreta-super-segura-fiap-esg-2026

# Configurações para Ambientes de Staging e Produção
STAGING_PORT=8081
STAGING_DB_URL=jdbc:oracle:thin:@oracle-db:1521/FREEPDB1
STAGING_DB_USER=fiap_user
STAGING_DB_PASSWORD=oracle123

PROD_PORT=8080
PROD_DB_URL=jdbc:oracle:thin:@oracle-db:1521/FREEPDB1
PROD_DB_USER=fiap_user
PROD_DB_PASSWORD=oracle123
